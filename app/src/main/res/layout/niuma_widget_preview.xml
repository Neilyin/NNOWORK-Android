<?xml version="1.0" encoding="utf-8"?>
<!-- 選擇器預覽（Android 12+ previewLayout），靜態呈現「上班中」小尺寸。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/niuma_preview_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/niuma_earned_today"
        android:textColor="@color/niuma_preview_secondary"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/niuma_preview_amount"
        android:textColor="@color/niuma_preview_money"
        android:textSize="28sp"
        android:textStyle="bold" />

    <ProgressBar
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:max="100"
        android:progress="49" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/niuma_until_off"
        android:textColor="@color/niuma_preview_secondary"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/niuma_preview_countdown"
        android:textColor="@color/niuma_preview_text"
        android:textSize="18sp"
        android:textStyle="bold"
        android:typeface="monospace" />
</LinearLayout>
